# Immich Configuration Environment Variables
# Copy this file to .env and configure as needed.

# 1. Storage Configuration
# The root path of your external HDD or main storage.
# For macOS, this typically points to '/Volumes/Disco 22tb' or similar.
EXTERNAL_DISK_PATH=/Volumes/Disco 22tb

# The location where your uploaded photos and videos are stored on the external disk.
UPLOAD_LOCATION=${EXTERNAL_DISK_PATH}/immich/library

# The location where your database files are stored on the external disk.
DB_DATA_LOCATION=${EXTERNAL_DISK_PATH}/immich/postgres

# 2. Server Domain Configuration
# The public domain where this Immich instance is hosted.
# Used for reverse-proxy routing and deep links.
IMMICH_DOMAIN=immich.chaldea.foundation

# 3. Port Customization & Binding
# The IP address the Immich port binds to. 
# Set to '127.0.0.1' to restrict access to localhost (secure when using a local reverse proxy like Pangolin/Newt).
# Set to '0.0.0.0' to allow access from any device on your local network.
IMMICH_BIND_ADDRESS=127.0.0.1

# The port where Immich is accessible on the host machine.
IMMICH_PORT=2283

# 4. Version Pinning
# The Immich version to use. It is recommended to pin this to a specific release or 'v3' major tag.
IMMICH_VERSION=v3

# 5. Database Credentials
# Connection secret for PostgreSQL database. CHANGE THIS to a secure password.
# Please use only the characters `A-Za-z0-9`, without special characters or spaces.
DB_PASSWORD=postgres

# The values below this line do not need to be changed under normal circumstances.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
